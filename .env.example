# Offline and scripted: runs without any external model or API key.
TWIN_PROVIDER=scripted

# Cheap OpenAI-compatible production option (pricing can change; re-check first).
# TWIN_PROVIDER=openai-compatible
# TWIN_LLM_BASE_URL=https://api.deepseek.com
# TWIN_LLM_API_KEY=
# TWIN_LLM_MODEL=deepseek-v4-flash

# Verified xAI alternative (same adapter; tested with Grok 4.5):
# TWIN_LLM_BASE_URL=https://api.x.ai/v1
# TWIN_LLM_API_KEY=
# TWIN_LLM_MODEL=grok-4.5

# Search defaults to public DuckDuckGo HTML and needs no key.
TWIN_SEARCH_PROVIDER=duckduckgo
# TWIN_SEARCH_API_KEY=

TWIN_DATABASE_URL=sqlite:///./digital-twin.db
TWIN_PUBLIC_BASE_URL=http://localhost:8000
TWIN_SHOW_PHONE=false

# The owner dashboard is disabled until both values are set.
TWIN_OWNER_USERNAME=owner
TWIN_OWNER_PASSWORD=

# Generate a long random value in production.
TWIN_HASH_SECRET=change-this-before-deploying
