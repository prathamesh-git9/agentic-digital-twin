# Offline and scripted: runs without any external model or API key.
TWIN_PROVIDER=scripted

# Cheap OpenAI-compatible production option (pricing can change; re-check first).
# TWIN_PROVIDER=openai-compatible
# TWIN_LLM_BASE_URL=https://api.deepseek.com
# TWIN_LLM_API_KEY=
# TWIN_LLM_MODEL=deepseek-v4-flash

# Verified xAI alternative (same adapter; tested with Grok 4.5):
# TWIN_LLM_BASE_URL=https://api.x.ai/v1
# TWIN_LLM_API_KEY=
# TWIN_LLM_MODEL=grok-4.5

# Search defaults to public DuckDuckGo HTML and needs no key.
TWIN_SEARCH_PROVIDER=duckduckgo
# TWIN_SEARCH_API_KEY=

TWIN_DATABASE_URL=sqlite:///./agentic-digital-twin.db
TWIN_PUBLIC_BASE_URL=http://localhost:8000
TWIN_SHOW_PHONE=false

# The owner dashboard is disabled until both values are set.
TWIN_OWNER_USERNAME=owner
TWIN_OWNER_PASSWORD=

# Generate a long random value in production.
TWIN_HASH_SECRET=change-this-before-deploying

# Real delivery is off unless every value is deliberately configured.
TWIN_SMTP_HOST=
TWIN_SMTP_PORT=
TWIN_SMTP_STARTTLS=
TWIN_SMTP_USERNAME=
TWIN_SMTP_PASSWORD=
TWIN_FROM_EMAIL=
TWIN_FROM_NAME=
TWIN_AUTOSEND=
TWIN_FANOUT_UNSELECTED=
TWIN_FANOUT_MAX=
TWIN_DAILY_SEND_CAP=
TWIN_SEND_CONFIDENCE_THRESHOLD=
TWIN_DKIM_SELECTORS=
TWIN_CALENDAR_URL=

# Owner-only local Playwright automation; off by default.
TWIN_LINKEDIN_AUTO=
TWIN_LINKEDIN_KILL_SWITCH=
TWIN_LINKEDIN_USER_DATA_DIR=
TWIN_LINKEDIN_DAILY_CAP=
TWIN_LINKEDIN_DELAY_MIN_SECONDS=
TWIN_LINKEDIN_DELAY_MAX_SECONDS=

# Short, non-fatal owner notifications; credentials remain only in .env.
TWIN_PUSHOVER_ENABLED=
TWIN_PUSHOVER_USER=
TWIN_PUSHOVER_TOKEN=
TWIN_HANDOFF_WEBHOOK_URL=
TWIN_TELEGRAM_BOT_TOKEN=
TWIN_TELEGRAM_CHAT_ID=

# Optional mailbox verification API; pattern inference remains labelled inferred.
TWIN_EMAIL_VERIFICATION_PROVIDER=
TWIN_EMAIL_VERIFICATION_API_KEY=
